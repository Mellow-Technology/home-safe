{
  "manifest_version": 3,
  "name": "Home Safe",
  "version": "0.1.0",
  "description": "Save Zillow listings into the Home Safe desktop app.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.zillow.com/*"],
      "js": ["src/zillow-extract.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Home Safe",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "home-safe@mellow.local", "strict_min_version": "121.0" }
  }
}
